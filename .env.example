# LLM provider (the reported studies used Vertex AI)
VERTEX_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=120

# SysIDE Automator licence key (paid product; the syside package checks it on import)
SYSIDE_LICENSE_KEY=

# Optional: LangSmith tracing of LLM calls (off when the key is empty)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default

# Only for the retrieval module in src/rag/
PINECONE_API_KEY=
